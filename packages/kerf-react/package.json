{
  "name": "kerf-react",
  "version": "1.1.0",
  "description": "Official plug-and-play React runtime for Kerf (.kfx) interactive motion graphics, vector animations, and state machines.",
  "license": "MIT",
  "author": "Kerf Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleastandby/kerf.git",
    "directory": "packages/kerf-react"
  },
  "homepage": "https://github.com/pleastandby/kerf/packages",
  "bugs": {
    "url": "https://github.com/pleastandby/kerf/issues"
  },
  "keywords": [
    "kerf",
    "rive",
    "lottie",
    "animation",
    "motion",
    "vector",
    "state-machine",
    "react",
    "canvas",
    "interactive"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.runtime.config.ts && tsc --emitDeclarationOnly",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
